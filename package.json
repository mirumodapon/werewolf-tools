{
  "name": "werewolf-tools",
  "version": "0.0.6",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:home": "pnpm --filter @werewolf/home dev",
    "dev:deal": "pnpm --filter @werewolf/deal dev",
    "dev:judge": "pnpm --filter @werewolf/judge dev",
    "dev:docs": "pnpm --filter @werewolf/docs dev",
    "build": "node scripts/build-all.ts",
    "preview": "node scripts/preview.ts",
    "lint": "vp lint && node scripts/check-catalog.ts && node scripts/check-boundaries.ts && node scripts/check-version.ts && node scripts/check-i18n.ts",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "vue-tsc -p scripts && vp run -r typecheck",
    "test": "vp test",
    "icons": "node packages/pwa/scripts/icons.ts",
    "new:app": "node scripts/new-app.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0"
}
